{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://screndly-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://screndly-production.up.railway.app/health"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
