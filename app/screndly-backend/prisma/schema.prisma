generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SETTINGS
// ============================================
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

// ============================================
// TMDB POSTS
// ============================================
model TMDbPost {
  id            String   @id @default(uuid())
  tmdbId        Int
  mediaType     String   // "movie" or "tv"
  moduleType    String?  // "today", "weekly", "monthly", "anniversary"
  title         String
  year          Int
  releaseDate   DateTime
  caption       String   @db.Text
  imageUrl      String
  imageType     String   // "poster", "backdrop", or "logo"
  imageUrls     String[] @default([])
  imageTypes    String[] @default([])
  scheduledTime DateTime
  source        String   // "tmdb_today", "tmdb_weekly", "tmdb_monthly", "tmdb_anniversary"
  cast          String[] // Array of cast members
  popularity    Float
  cacheHit      Boolean  @default(false)
  status        String   // "queued", "scheduled", "dispatched", "published", "failed", "unscheduled", "skipped"
  platforms     String[] // ["X", "Threads", "Facebook"]
  runId         String?
  captionContextHash String?
  overflowPolicy String?
  overflowExpiresAt DateTime?
  unscheduledReason String? @db.Text
  dispatchedAt  DateTime?
  publishedTime DateTime?
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@index([source])
  @@index([tmdbId])
  @@index([moduleType])
  @@index([runId])
}

model ReleaseFeedHistory {
  id                     String   @id @default(uuid())
  provider               String
  moduleType             String   // "today", "weekly", "monthly", "anniversary"
  mediaType              String   // "movie" or "tv"
  tmdbId                 Int
  imdbId                 String?
  canonicalKey           String
  cycleKey               String
  title                  String
  releaseDate            DateTime
  originalReleaseDate    DateTime?
  anniversaryMilestone   Int?
  firstFetchedAt         DateTime @default(now())
  lastSeenAt             DateTime @default(now())
  scheduledAt            DateTime?
  dispatchedAt           DateTime?
  publishedAt            DateTime?
  status                 String   // "fetched", "scheduled", "dispatched", "published", "skipped", "unscheduled"
  skipReason             String?  @db.Text
  runId                  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([cycleKey])
  @@index([canonicalKey])
  @@index([moduleType, status])
  @@index([releaseDate])
  @@index([tmdbId])
  @@index([runId])
}

// ============================================
// RSS FEEDS (Extended for full frontend support)
// ============================================
model RSSFeed {
  id              String   @id @default(uuid())
  
  // Basic Info
  name            String   // Feed display name
  url             String   // RSS feed URL
  favicon         String?  // Favicon URL
  
  // Content Settings
  enabled         Boolean  @default(true)
  interval        Int      @default(10)  // Minutes between checks
  imageCount      String   @default("2") // "1", "2", "3", "random"
  dedupeDays      Int      @default(30)  // Days to check for duplicates
  
  // Filters (JSON: { scope, required[], blocked[] })
  filters         Json     @default("{\"scope\":\"title_or_body\",\"required\":[],\"blocked\":[]}")
  
  // Image Settings
  serperEnabled   Boolean  @default(true)
  tmdbEnabled     Boolean  @default(false)
  serperPriority  Boolean  @default(true)
  rehostImages    Boolean  @default(false)
  platformImageCounts Json?
  
  // Posting Settings
  autoPost        Boolean  @default(true)
  platformsEnabled Json    @default("{\"x\":true,\"threads\":true,\"facebook\":false,\"pinterest\":false}")
  trickle         String   @default("newest_first")
  
  // Status & Timing
  status          String   @default("active") // "active", "paused", "error"
  lastProcessedAt DateTime?
  nextRunAt       DateTime?
  
  // Legacy fields (for backward compatibility)
  source          String?  // Deprecated: use name
  title           String?  // Article title (when used as item)
  description     String?  @db.Text
  imageUrl        String?
  publishedDate   DateTime @default(now())
  scheduledTime   DateTime?
  platforms       String[] // Legacy: use platformsEnabled
  caption         String?  @db.Text
  errorMessage    String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           RSSFeedItem[]

  @@index([status])
  @@index([enabled])
  @@index([name])
}

model RSSFeedItem {
  id              String   @id @default(uuid())
  feedId          String
  dedupeKey       String
  title           String
  link            String
  guid            String?
  status          String   @default("pending") // "pending", "published", "failed", "filtered"
  itemData        Json
  firstSeenAt     DateTime @default(now())
  lastAttemptedAt DateTime?
  publishedAt     DateTime?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  feed RSSFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, dedupeKey])
  @@index([feedId, status])
  @@index([firstSeenAt])
}

// ============================================
// CHANNELS (YouTube monitoring)
// ============================================
model Channel {
  id              String   @id @default(uuid())
  channelId       String   @unique // YouTube channel ID
  name            String
  subscriberCount Int      @default(0)
  videoCount      Int      @default(0)
  status          String   // "active", "inactive", "error"
  lastCheck       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  feedItems       FeedItem[]

  @@index([channelId])
  @@index([status])
}

// ============================================
// FEED ITEMS (YouTube Polling History)
// ============================================
model FeedItem {
  id          String   @id @default(uuid())
  videoId     String   @unique // YouTube Video ID
  channelId   String
  title       String
  status      String   @default("accepted") // "accepted", "ignored", or legacy rows migrated from older builds
  decisionPath String?
  promoFingerprint String?
  duplicateOfVideoId String?
  decisionLog Json?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  channel     Channel  @relation(fields: [channelId], references: [channelId], onDelete: Cascade)

  @@index([channelId])
  @@index([publishedAt])
  @@index([status])
  @@index([promoFingerprint])
  @@index([duplicateOfVideoId])
}

model PromoDedupIndex {
  id                      String   @id @default(uuid())
  canonicalFingerprint    String   @unique
  matchedMetadataId       String?
  normalizedTitle         String
  mediaType               String
  seasonNumber            Int?
  releaseYear             Int?
  promoAssetType          String
  chosenCanonicalVideoId  String
  chosenCanonicalChannelId String
  sourcePriorityScore     Int      @default(0)
  firstSeenAt             DateTime @default(now())
  lastSeenAt              DateTime @default(now())
  duplicateCount          Int      @default(0)
  duplicateVideoIds       String[]
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([matchedMetadataId])
  @@index([normalizedTitle, mediaType, promoAssetType])
  @@index([chosenCanonicalVideoId])
}

// ============================================
// UPLOAD JOBS
// ============================================
model UploadJob {
  id            String   @id @default(uuid())
  fileName      String
  fileSize      Int      // bytes
  sourceUrl     String?
  status        String   // "pending", "processing", "completed", "failed"
  stage         String   // "queued", "processing", "generating_metadata", etc.
  progress      Int      @default(0) // 0-100
  metadata      Json     // JobMetadata structure
  scheduledFor  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?
  error         Json?    // { message, cause, stack }
  events        Json[]   // Array of JobEvent objects
  costEstimate  Float?
  backendUsed   String?  // "google-video-intelligence" or "ffmpeg"

  @@index([status])
  @@index([stage])
  @@index([createdAt])
}

// ============================================
// COMMENTS
// ============================================
model Comment {
  id         String   @id @default(uuid())
  platform   String   // "X", "Threads", "Facebook"
  commentId  String   // Platform's comment ID
  postId     String   // Platform's post ID
  username   String
  content    String   @db.Text
  reply      String?  @db.Text
  repliedAt  DateTime?
  processed  Boolean  @default(false)
  blacklisted Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([platform, commentId])
  @@index([platform])
  @@index([processed])
  @@index([repliedAt])
}

// ============================================
// NOTIFICATIONS
// ============================================
model Notification {
  id         String   @id @default(uuid())
  type       String   // "success", "error", "warning", "info"
  title      String
  message    String   @db.Text
  source     String   // "tmdb", "rss", "upload", "comment", "system"
  actionPage String?  // "/tmdb", "/rss", etc.
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read])
  @@index([source])
  @@index([createdAt])
}

model PushSubscription {
  id             String   @id @default(uuid())
  endpoint       String   @unique @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  expirationTime DateTime?
  userAgent      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  failureCount   Int      @default(0)

  @@index([createdAt])
  @@index([updatedAt])
}

// ============================================
// LOGS
// ============================================
model Log {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  level     String   // "info", "warn", "error", "debug"
  message   String   @db.Text
  service   String   // "api", "cron", "worker"
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([service])
  @@index([timestamp])
}

// ============================================
// PLATFORM CONNECTIONS
// ============================================
model PlatformConnection {
  id           String   @id @default(uuid())
  platform     String   @unique // "X", "Threads", "Facebook"
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  username     String?
  userId       String?  // Platform user ID
  metadata     Json?    // Platform-specific data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform])
}

// ============================================
// DESIGN STUDIO ACTIVITY
// ============================================
model DesignStudioActivity {
  id        String   @id @default(uuid())
  type      String   // "template_uploaded", "design_rendered", "design_published"
  details   Json
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// ============================================
// VIDEO STUDIO ACTIVITY
// ============================================
model VideoStudioActivity {
  id            String   @id @default(uuid())
  type          String   // "review", "monthly", "scenes"
  title         String
  status        String   // "processing", "completed", "failed"
  aspectRatio   String?
  duration      String?
  downloads     Int      @default(0)
  published     Boolean  @default(false)
  platforms     String[]
  error         String?  @db.Text
  progress      Int?
  sceneSource   String?
  sceneStart    String?
  sceneEnd      String?
  sceneSourceName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// API USAGE TRACKING
// ============================================
model ApiUsage {
  id        String   @id @default(uuid())
  service   String   // "openai", "serper", "tmdb", "shotstack", "googleSearch", "googleVideo"
  endpoint  String?
  tokens    Int      @default(0)
  cost      Float    @default(0.0)
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([service])
  @@index([createdAt])
}
