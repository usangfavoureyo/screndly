# Backblaze B2 bucket fallbacks.
# Saved settings from the app take priority over these env values.
BACKBLAZE_ENDPOINT=s3.us-west-004.backblazeb2.com

# General uploads bucket
BACKBLAZE_GENERAL_KEY_ID=
BACKBLAZE_GENERAL_APPLICATION_KEY=
BACKBLAZE_GENERAL_BUCKET_NAME=

# Videos bucket
BACKBLAZE_VIDEOS_KEY_ID=
BACKBLAZE_VIDEOS_APPLICATION_KEY=
BACKBLAZE_VIDEOS_BUCKET_NAME=

# Design bucket
BACKBLAZE_DESIGN_KEY_ID=
BACKBLAZE_DESIGN_APPLICATION_KEY=
BACKBLAZE_DESIGN_BUCKET_NAME=

# Optional yt-dlp authentication for YouTube downloads.
# Option A: let yt-dlp read cookies from a signed-in browser.
# On some Windows machines this can fail because Chrome/Edge cookies use DPAPI/app-bound encryption.
YT_DLP_COOKIES_FROM_BROWSER=chrome
#
# Option B: export a Netscape-format cookie file from the browser and point yt-dlp at it.
# This is the most reliable fallback when browser-cookie extraction is blocked.
# YT_DLP_COOKIE_FILE_PATH=C:\\path\\to\\yt-dlp-cookies.txt
